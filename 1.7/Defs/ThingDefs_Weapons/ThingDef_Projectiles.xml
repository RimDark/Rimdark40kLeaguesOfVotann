    <!-- Magna Rail Mode: Standard -->
    <ThingDef ParentName="BaseBullet">
        <defName>BEWH_BoltVotannRailgunStandard</defName>
        <label>Standard Mode</label>
        <description>Standard firing mode. Magna Rail Rifle fires a magnetically accelerated projectile at extreme velocity. Accuracy depends entirely on the shooter's skill.</description>
        <thingClass>Bullet</thingClass>
        <uiIconPath>UI/AmmoSwitcher/BEWH_Votann_MagnaMode_Manuel</uiIconPath>
        <graphicData>
            <texPath>Things/Projectile/Needle</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(0.8, 0.8)</drawSize>
        </graphicData>
        <projectile>
            <damageDef>Bullet</damageDef>
            <damageAmountBase>40</damageAmountBase>
            <armorPenetrationBase>0.55</armorPenetrationBase>
            <screenShakeFactor>0.1</screenShakeFactor>
            <speed>110</speed>
        </projectile>
        <modExtensions>
            <li Class="Core40k.DefModExtension_AmmoChanger" />
        </modExtensions>
    </ThingDef>

    <!-- Magna Rail Mode: Lock-on -->
    <ThingDef ParentName="BaseBullet">
        <defName>BEWH_BoltVotannRailgunLockOn</defName>
        <label>Lock-on Mode</label>
        <description>The weapon's onboard AI continuously predicts both target movement and projectile flight, computing a precise firing solution. If the shot is placed in the target's vicinity, it will strike the target's head with perfect accuracy, causing devastating damage.\n\nCalculating the firing solution requires considerable time.</description>
        <thingClass>Bullet</thingClass>
        <uiIconPath>UI/AmmoSwitcher/BEWH_Votann_MagnaMode_Lock-on</uiIconPath>
        <graphicData>
            <texPath>Things/Projectile/Needle</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(0.8, 0.8)</drawSize>
        </graphicData>
        <projectile>
            <damageDef>Bullet</damageDef>
            <damageAmountBase>40</damageAmountBase>
            <armorPenetrationBase>0.55</armorPenetrationBase>
            <screenShakeFactor>0.1</screenShakeFactor>
            <speed>110</speed>
        </projectile>
        <modExtensions>
            <li Class="Core40k.DefModExtension_AmmoChanger">
                <warmupTime>2</warmupTime> <!-- to be set -->
            </li>
            <!-- add bodypart selector extension -->
        </modExtensions>
    </ThingDef>

    <!-- Magna Rail Mode: "Grudge" --> <!-- We're seriously doing this? lol -->
    <ThingDef ParentName="BaseBullet">
        <defName>BEWH_BoltVotannRailgunGrudge</defName>
        <label>Grudge Mode</label>
        <description>The result of allowing an exceptionally bitter Kin engineer unrestricted access to the design process. Rather than seeking the quickest kill, the rifle's onboard AI is forced to calculate a perfect targeting solution aimed at the target's crotch. The psychological impact is considered highly satisfactory.\n\n“Some grudges simply deserve a more personal touch.” - Grimnyr Chesekhyr</description>
        <thingClass>Bullet</thingClass>
        <uiIconPath>UI/AmmoSwitcher/BEWH_Votann_MagnaMode_Grudge</uiIconPath>
        <graphicData>
            <texPath>Things/Projectile/Needle</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(0.8, 0.8)</drawSize>
        </graphicData>
        <projectile>
            <damageDef>BEWH_Damage_Grudge</damageDef>
            <damageAmountBase>40</damageAmountBase>
            <armorPenetrationBase>0.55</armorPenetrationBase>
            <screenShakeFactor>0.1</screenShakeFactor>
            <speed>110</speed>
        </projectile>
        <modExtensions>
            <li Class="Core40k.DefModExtension_AmmoChanger">
                <warmupTime>2</warmupTime> <!-- to be set -->
            </li>
            <li Class="Votann40k.DefModExtension_GrudgeAmmo">
                <hitChanceFactor>1.25</hitChanceFactor>
            </li>
        </modExtensions>
    </ThingDef>

