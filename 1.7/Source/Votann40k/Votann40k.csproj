<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <LangVersion>latest</LangVersion>
        <RootNamespace>Votann40k</RootNamespace>
        <AssemblyName>Votann40k</AssemblyName>
        <OutputType>Library</OutputType>
        <OutputPath>..\..\Assemblies\</OutputPath>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
        <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>disable</Nullable>
        <DebugType>none</DebugType>
        <DebugSymbols>false</DebugSymbols>
        <Optimize>true</Optimize>
        <GenerateDependencyFile>false</GenerateDependencyFile>
        <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
        <!-- Relative default assumes the mod sits in RimWorld\Mods; a Directory.Build.props above the repo can override it -->
        <WorkshopDir Condition="'$(WorkshopDir)' == ''">..\..\..\..\..\..\..\workshop\content\294100\</WorkshopDir>
    </PropertyGroup>
    <ItemGroup>
        <!-- Krafs.Rimworld.Ref must match the game build in RimWorld\Version.txt; Lib.Harmony.Ref must match the Workshop Harmony 1.7 build -->
        <PackageReference Include="Krafs.Rimworld.Ref" Version="1.7.4985-unstable" />
        <PackageReference Include="Lib.Harmony.Ref" Version="3.0.0-rc.3" />
    </ItemGroup>
    <ItemGroup>
        <Reference Include="Core40k">
            <HintPath>..\..\..\..\Rimdark40kFramework\1.7\Assemblies\Core40k.dll</HintPath>
            <Private>False</Private>
        </Reference>
        <Reference Include="VEF">
            <HintPath>$(WorkshopDir)2023507013\1.7\Assemblies\VEF.dll</HintPath>
            <Private>False</Private>
        </Reference>
    </ItemGroup>
</Project>
