<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <!-- Kin League: thurian stock -->
    <GeneDef ParentName="BEWH_VotannGenesOverallParent">
        <defName>BEWH_KinLeagueThurian</defName>
        <label>thurian stock</label>
        <description>Carriers were grown from Greater Thurian League cloneskein. Generations of deep-core mining have left them faster and more thorough at the rock face.</description>
        <iconPath>UI/Genes/Kin/BEWH_ClanLoyalty</iconPath>
        <biostatCpx>2</biostatCpx>
        <biostatMet>-1</biostatMet>
        <displayOrderInCategory>50</displayOrderInCategory>

        <canGenerateInGeneSet>false</canGenerateInGeneSet>
        <exclusionTags>
            <li>BEWH_KinLeague</li>
        </exclusionTags>

        <statOffsets>
            <MiningYield>0.15</MiningYield>
            <MiningSpeed>0.15</MiningSpeed>
            <DeepDrillingSpeed>0.15</DeepDrillingSpeed>
        </statOffsets>
        <aptitudes>
            <Mining>3</Mining>
        </aptitudes>
    </GeneDef>

